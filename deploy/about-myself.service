[Unit]
Description=About Myself FastAPI backend (uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/about-myself-backend
Environment="PATH=/home/ubuntu/about-myself-backend/.venv/bin"
ExecStart=/home/ubuntu/about-myself-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
